<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_Sociable</defName>
    <positiveLabel>socially active</positiveLabel>
    <negativeLabel>socially withdrawn</negativeLabel>
    <positiveDescription>Initiates social interactions more often.</positiveDescription>
    <negativeDescription>Initiates social interactions less often.</negativeDescription>
    <threshold>0.4</threshold>
    <strongThreshold>0.8</strongThreshold>
    <workerClass>Maux36.RimPsyche.SociabilityDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_Eloquence</defName>
    <positiveLabel>builds rapport</positiveLabel>
    <positiveDescription>Shared topic attitudes improve conversations more.</positiveDescription>
    <negativeDescription>Shared topic attitudes improve conversations less.</negativeDescription>
    <threshold>0.4</threshold>
    <strongThreshold>0.8</strongThreshold>
    <workerClass>Maux36.RimPsyche.EloquenceDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_InitIntentFactor</defName>
    <positiveLabel>likely to offend</positiveLabel>
    <negativeLabel>unlikely to offend</negativeLabel>
    <positiveDescription>More likely to offend others.</positiveDescription>
    <negativeDescription>Less likely to offend others.</negativeDescription>
    <threshold>0.3</threshold>
    <strongThreshold>0.5</strongThreshold>
    <extremeThreshold>0.7</extremeThreshold>
    <workerClass>Maux36.RimPsyche.InitIntentFactorDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_ReciNegativeChanceFactor</defName>
    <positiveLabel>easily offended</positiveLabel>
    <negativeLabel>hard to offend</negativeLabel>
    <positiveDescription>More likely to take offense.</positiveDescription>
    <negativeDescription>Less likely to take offense.</negativeDescription>
    <threshold>0.55</threshold>
    <workerClass>Maux36.RimPsyche.ReciNegativeChanceFactorDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_ReceptiveBase</defName>
    <!-- involves openness, tact~talkativeness, trust -->
    <positiveLabel>tolerates differences</positiveLabel>
    <negativeLabel>rejects differences</negativeLabel>
    <positiveDescription>Opposing topic attitudes dampen conversations less.</positiveDescription>
    <negativeDescription>Opposing topic attitudes dampen conversations more.</negativeDescription>
    <threshold>0.55</threshold>
    <workerClass>Maux36.RimPsyche.ReceptiveBaseDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_TalkFactor</defName>
    <positiveLabel>impactful communicator</positiveLabel>
    <positiveDescription>Conversations have stronger outcomes.</positiveDescription>
    <negativeDescription>Conversations have weaker outcomes.</negativeDescription>
    <threshold>0.4</threshold>
    <strongThreshold>0.8</strongThreshold>
    <workerClass>Maux36.RimPsyche.TalkFactorDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_InterestedTopicAttitude</defName>
    <positiveLabel>deeply invested</positiveLabel>
    <negativeLabel>less invested</negativeLabel>
    <positiveDescription>High interest in a topic improves conversations more.</positiveDescription>
    <negativeDescription>High interest in a topic improves conversations less.</negativeDescription>
    <threshold>0.55</threshold>
    <workerClass>Maux36.RimPsyche.InterestedTopicAttitudeDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>

  <Maux36.RimPsyche.PsycheDescriptorDef>
    <defName>RP_Desc_UnInterestedTopicAttitude</defName>
    <positiveLabel>curious communicator</positiveLabel>
    <negativeLabel>indifferent communicator</negativeLabel>
    <positiveDescription>Low interest in a topic dampens conversations less.</positiveDescription>
    <negativeDescription>Low interest in a topic dampens conversations more.</negativeDescription>
    <threshold>0.55</threshold>
    <workerClass>Maux36.RimPsyche.UnInterestedTopicAttitudeDescriptorWorker</workerClass>
  </Maux36.RimPsyche.PsycheDescriptorDef>
</Defs>
